# Supabase ile aynı yol: https://<adres>/rest/v1/<tablo>
# SITE_ADDRESS boşsa :80 (yerel/tünel). Sunucuda docker/.env → SITE_ADDRESS=db.ornek.com yazılır;
# Caddy Let's Encrypt sertifikasını kendisi alır ve yeniler.
{$SITE_ADDRESS::80} {
	encode gzip
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle {
		respond "RSSBot DB gateway" 200
	}
}
